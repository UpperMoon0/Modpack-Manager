{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modpack Manager",
  "version": "1.0.0",
  "identifier": "dev.nstut.modpack-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Modpack Manager",
        "width": 980,
        "height": 820,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
