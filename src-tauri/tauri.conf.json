{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modpack Manager",
  "version": "1.0.0",
  "identifier": "dev.nstut.modpack-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Modpack Manager",
        "width": 980,
        "height": 860,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgOTM3QjVBM0Y3RTMwOTVDMApSV1RBbFRCK1AxcDdrMnpKRkxEVnZEZFhRZmg4Qk1sc0I1STZDcnpGYjBEeEk4NG5Za1NsWHFCNwo=",
      "endpoints": [
        "https://github.com/UpperMoon0/Modpack-Manager/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
